# PostgreSQL (configured externally; never commit the real value)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/carewell?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Appointment-bound video tokens / LiveKit
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
JWT_SIGNING_SECRET=""
STUN_SERVER_URL="stun:your-stun-host:3478"
TURN_SERVER_URL="turns:your-coturn-host:5349"
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Stripe Connect (test credentials only until provider setup is approved)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Razorpay Route
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# FCM / Twilio
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_JSON=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# AWS deployment (supply through runtime secrets/IAM, not frontend variables)
AWS_REGION="ap-south-1"
AWS_KMS_KEY_ARN=""
AWS_S3_BUCKET=""
